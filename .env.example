# Copy this file to .env and fill in real values. Never commit .env.

# From https://my.telegram.org (API Development Tools)
TG_API_ID=123456
TG_API_HASH=your_api_hash_here

# Generated once by running: python login.py
TG_SESSION_STRING=your_session_string_here

# Any long random secret you invent — n8n must send this as X-API-Key
BRIDGE_API_KEY=change_me_to_a_long_random_secret
